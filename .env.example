# 复制本文件为 .env 后填写（.env 已被 .gcloudignore / .dockerignore 排除，不会上传到云端）
# ===== 必填 =====
# @BotFather 创建机器人后得到
TELEGRAM_BOT_TOKEN=
# 你的 Telegram 数字 ID（可先启动 Bot 后发送 /id 获取，或问 @userinfobot）；多人用英文逗号分隔
ALLOWED_USER_ID=
# Google AI Studio → Get API key。留空时归档可用的原始素材，供后续整理。
GEMINI_API_KEY=
# https://www.notion.so/my-integrations → New integration（Internal），以 ntn_ 开头
NOTION_TOKEN=

# ===== Notion 数据库 =====
# 方式一（推荐）：填一个已授权给 Integration 的父页面 ID/链接，运行 python setup_notion.py 自动建「归档总表」和「分类配置」并回填 NOTION_DB_ARCHIVE / NOTION_DB_CONFIG
NOTION_PARENT_PAGE_ID=

# ===== Google Cloud 部署 =====
GCP_PROJECT_ID=tg-notion-clipper
GCP_REGION=us-central1
# 可选：填结算账号 ID（形如 012345-6789AB-CDEF01）则 deploy.ps1 自动创建 1 美元预算告警
GCP_BILLING_ACCOUNT=
# 预算金额，币种须与结算账号一致（港币账号写 80HKD，美元账号写 10USD）
GCP_BUDGET_AMOUNT=80HKD

# ===== 可选 =====
# 可选，只读 Token；公开 GitHub 仓库也可直接使用匿名 REST API。
GITHUB_TOKEN=
# 可选，归档总表同结构；链接或 AI 失败时优先写入。不填则沿用归档总表。
NOTION_DB_INBOX=
# 全局建议标签，使用逗号或顿号分隔。
GLOBAL_SUGGESTED_TAGS=
# 留空则 deploy.ps1 自动生成
WEBHOOK_SECRET=
# 可选。单独设置随机密钥可撤销全部浏览器配对而不影响 Telegram Webhook。
BROWSER_CLIP_SECRET=
# 免费 Key 可提升 Jina Reader 限速
JINA_API_KEY=
# 可选。超出该预算时 Jina 拒绝请求，随后尝试直连。留空保留默认服务行为。
JINA_TOKEN_BUDGET=
# 可选。控制 Jina 保留图片策略（默认 all，非图任务省流可设 none）。
JINA_RETAIN_IMAGES=
# 可选（本地开发备用）。Cloud Run 镜像纯 Python 运行，不依赖 Node.js，默认无需启用。
DEFUDDLE_ENABLED=
# 可选。设为 flex 启用 Gemini 5 折推理，遇超时或限流自动回退 standard。
GEMINI_SERVICE_TIER=
# 可选。仅纯公开链接（无私人批注、无私密媒体）使用的免费层 Key。
GEMINI_API_KEY_FREE=
# 可选。GitHub 精选评论条数与字符预算。
GITHUB_COMMENT_LIMIT=12
GITHUB_COMMENT_BUDGET=8000
# 可选。相册聚合静默窗口与最大等待时间（秒）。
ALBUM_SILENCE_SECONDS=2.0
ALBUM_MAX_WAIT_SECONDS=8.0
# 可选。视频关键帧上限与下载时长上限（秒）。
VIDEO_MAX_KEYFRAMES=8
VIDEO_MAX_DURATION_SEC=1800
# 可选。多用户独立知识库 JSON 映射（或 USER_CONFIGS_FILE 文件路径），与加密主密钥 CLIPPER_MASTER_KEY 配合使用。
# 注意：启用多用户后管理员自己也须在 USER_CONFIGS 中占一条；deploy.ps1 会将其打包进单个 Secret Manager 合并包（CLIPPER_SECRETS）。
USER_CONFIGS=
USER_CONFIGS_FILE=
CLIPPER_MASTER_KEY=
# 可选。统一 /ingest 与 /jobs/run 鉴权密钥（留空时回退 WEBHOOK_SECRET），以及本地 SQLite WAL 索引路径。
INGEST_SECRET=
CLIPPER_DB_PATH=
# Firecrawl 免费版每月 1,000 credits（firecrawl.dev 用 Google 登录后在 API Keys 页复制）
FIRECRAWL_API_KEY=
# Reddit 官方 OAuth（可选）：reddit.com/prefs/apps 创建 script 类应用后填写；未填则走公开 JSON → Jina 降级
# 注意：据 r/redditdev 官方迁移公告（二手来源转述），2026-10-31 起不再受理新的公开 API 申请，2027-03 关闭公开 API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 你的 Reddit 用户名（只用于按 Reddit 规范拼 User-Agent）
REDDIT_USERNAME=
# 模型可随时改，无需改代码
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# 可选。较大的 PDF、视频和明确的精读请求优先使用这个模型，留空时沿用备用模型。
GEMINI_COMPLEX_MODEL=
# Firecrawl：每月 1,000 credits，注册 https://firecrawl.dev 后取 Key
FIRECRAWL_API_KEY=
# Tavily Extract：每月 1,000 credits（约 5,000 页），注册 https://tavily.com 后取 Key
TAVILY_API_KEY=
# ZenRows：每月 5,000 credits，注册 https://zenrows.com 后取 Key
ZENROWS_API_KEY=
NOTION_DB_ARCHIVE=
NOTION_DB_CONFIG=
